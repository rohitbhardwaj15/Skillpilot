MONGODB_URI=mongodb+srv://skillpilot:<password>@cluster0.xxxxx.mongodb.net/skillpilot
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# CORS: comma-separated list of allowed frontend origins
# Local dev: http://localhost:5173
# Production: https://your-app.vercel.app
CLIENT_URLS=http://localhost:5173,https://skillpilot-app.vercel.app

# Groq API key — free at https://console.groq.com/keys
LLM_API_KEY=gsk_your_groq_key_here

# Optional — LLM call resilience tuning (sensible defaults are used if unset)
# LLM_TIMEOUT_MS=12000
# LLM_MAX_RETRIES=2

# Optional — real dense embeddings for the semantic recommendation layer.
# Any OpenAI-compatible /embeddings endpoint works (OpenAI, Voyage, Together, etc).
# Without these, the app automatically falls back to a deterministic local
# hashed embedding, so it works fully offline / without an API key too.
# EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
# EMBEDDING_API_KEY=sk-your-embedding-key-here
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_TIMEOUT_MS=4000

# Optional — distributed rate limiting across multiple server instances
# (e.g. Vercel serverless). Free tier at https://console.upstash.com.
# Without these, rate limiting falls back to a per-instance in-memory
# counter, which still works for a single Node process.
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Optional — SMTP for sending password-reset emails. Any standard SMTP
# provider works (Gmail app password, SendGrid, Mailgun, Resend, etc).
# Without these, forgot-password still works — the reset link is logged
# to the server console instead of emailed, so the flow is testable
# without real email credentials.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=SkillPilot <no-reply@skillpilot.app>

