# Copy this file to .env and fill in real values. Never commit .env itself.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skillpilot
PORT=5000
# Free API key from https://console.groq.com/keys — used for goal analysis & explanations
LLM_API_KEY=your_groq_api_key_here
# Any long random string — used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_random_secret_here
